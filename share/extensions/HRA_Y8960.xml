<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>
  <info>
    <name>Y8960 Cartridge</name>
    <manufacturer>HRA!</manufacturer>
    <code/>
    <release_year>2026</release_year>
    <description>MSX2++ equivalent sound cartridge.</description>
    <type>sound expansion</type>
  </info>
  <devices>
    <!-- 各音源の <volume> は、実機で測った音源どうしの比に合わせ、最大の OPM を 30000 にした。
         上流の相当品（fmpac.xml、audio.xml、scc.xml など）の値とは違う -->
    <MSX-TIMER id="y8960-timer">
      <io base="0xB0" num="4"/>
    </MSX-TIMER>
    <!-- I/O 40h-4Fh。40h に 80h を書くと有効になり、41h に 02h でこのカートリッジを選ぶ。
         識別までで、Config ROM の読み書き（42h の機能 01h の先）は持たない -->
    <Y8960-SYSTEM-CONTROLLER id="Y8960 System Controller"/>
    <!-- SSGS 1 個。内部に YM2149 相当の SSG が 2 系統あり、00h-0Fh が系統 0、
         10h-1Fh が系統 1。20h 台にチャンネルごとの音量と定位。
         A0h=レジスタ番号、A1h=書き込み。
         本体 PSG と同じポートに重なるのは実機どおり。実機は系統 1 の読み出しに
         A2h で応じるが、ここでは応じない（入力ポートを本体 PSG と重ねると、
         挿すたびに openMSX が警告を出す） -->
    <Y8960-SSGS id="Y8960 SSGS">
      <io base="0xA0" num="4" type="O"/>
      <sound>
        <volume>15003</volume>
      </sound>
    </Y8960-SSGS>
    <Y8960-OPLL id="Y8960 OPLL">
      <io base="0x7C" num="2" type="O"/>
      <sound>
        <volume>7009</volume>
      </sound>
    </Y8960-OPLL>
    <!-- ADPCM のサンプルメモリ 256KB。SRAM の 40000h-7FFFFh にあたる。
         OPL2 より先に置くこと（OPL2 が構築時に参照する） -->
    <Y8960-ADPCM-RAM id="Y8960 ADPCM RAM"/>
    <Y8960-OPL2 id="Y8960 OPL2">
      <io base="0xC0" num="2"/>
      <adpcm_memory>Y8960 ADPCM RAM</adpcm_memory>
      <sound>
        <volume>7433</volume>
      </sound>
    </Y8960-OPL2>
    <!-- 7Eh=アドレス、7Fh=データ。7Fh を読むとステータス -->
    <Y8960-OPM id="Y8960 OPM">
      <io base="0x7E" num="2"/>
      <sound>
        <volume>30000</volume>
      </sound>
    </Y8960-OPM>
    <primary slot="any">
      <secondary slot="any">
        <ROM id="Y8960 SCC">
          <mem base="0x4000" size="0x8000"/>
          <sound>
            <volume>7509</volume>
          </sound>
          <mappertype>Y8960</mappertype>
          <rom/>
          <!-- メモリマップド I/O の窓の番地と I/O Enabler のビットは
               RomY8960.cc の先頭にまとめてある -->
          <opll>Y8960 OPLL</opll>
          <opl2>Y8960 OPL2</opl2>
          <ssgs>Y8960 SSGS</ssgs>
          <opm>Y8960 OPM</opm>
          <timer>y8960-timer</timer>
          <mixer>y8960-mixer</mixer>
        </ROM>
      </secondary>
    </primary>
    <!-- ミキサーに I/O ポートは無く、音量はメモリマップド I/O の
         7FF7h + チャンネル番号で書く。4 と 5（7FFBh / 7FFCh）は OPM のポートで、
         音量ではない。マスター音量は 7FFEh で、全チャンネルに掛かる。
         ADPCM は OPL2 に混ざり、OPL2 の音量に従う。
         SCC の音源を参照するので ROM より後に置くこと。
         カートリッジは音声を本体に戻さないので、既定は Y8960 側の出力だけ。
         y8960-mixer_output 設定で msx / mix に切り替えられる -->
    <Y8960-MIXER id="y8960-mixer">
      <default_output>y8960</default_output>
      <channel num="0" idref="Y8960 SSGS"/>
      <channel num="1" idref="Y8960 OPLL"/>
      <channel num="2" idref="Y8960 OPL2"/>
      <channel num="3" idref="Y8960 SCC"/>
      <channel num="6" idref="Y8960 OPM"/>
    </Y8960-MIXER>
  </devices>
</msxconfig>
