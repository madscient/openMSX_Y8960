<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>
  <info>
    <name>Y8960 Cartridge</name>
    <manufacturer>HRA!</manufacturer>
    <code/>
    <release_year>2026</release_year>
    <description>MSX2++ equivalent sound cartridge.</description>
    <type>sound expansion</type>
  </info>
  <devices>
    <MSX-TIMER id="y8960-timer">
      <io base="0xB0" num="4"/>
    </MSX-TIMER>
    <!-- SSGS: YM2149 2 系統。$00-$1F が系統 0、$20-$3F が系統 1 で、
         各系統の $10-$12 が 4bit パンポット。A0h=レジスタ番号、A1h=書き込み、
         A2h=読み出し。本体 PSG と同じポートに重なるのは実機どおり -->
    <Y8960-SSG id="Y8960 SSG">
      <io base="0xA0" num="4"/>
      <sound>
        <volume>21000</volume>
      </sound>
    </Y8960-SSG>
    <!-- DCSG は 1 ポートずつで、アドレス bit0 が 2 回路のどちらかを選ぶ -->
    <SNPSG id="Y8960 DCSG 0">
      <io base="0x3E" num="1" type="O"/>
      <sound>
        <volume>21000</volume>
      </sound>
    </SNPSG>
    <SNPSG id="Y8960 DCSG 1">
      <io base="0x3F" num="1" type="O"/>
      <sound>
        <volume>21000</volume>
      </sound>
    </SNPSG>
    <Y8960-OPLL id="Y8960 OPLL 0">
      <io base="0x7C" num="2" type="O"/>
      <sound>
        <volume>13000</volume>
      </sound>
      <ym2413-core>NukeYKT-Banked</ym2413-core>
    </Y8960-OPLL>
    <Y8960-OPLL id="Y8960 OPLL 1">
      <io base="0x7A" num="2" type="O"/>
      <sound>
        <volume>13000</volume>
      </sound>
      <ym2413-core>NukeYKT-Banked</ym2413-core>
    </Y8960-OPLL>
    <!-- OPL2 + ADPCM-B. Address bit 1 picks the circuit, so C0h-C1h and the
         7FECh tunnel reach the same one. -->
    <Y8960-OPL2 id="Y8960 OPL2 0">
      <io base="0xC0" num="2"/>
      <sampleram>256</sampleram>
      <sound>
        <volume>12000</volume>
      </sound>
    </Y8960-OPL2>
    <Y8960-OPL2 id="Y8960 OPL2 1">
      <io base="0xC2" num="2"/>
      <sampleram>256</sampleram>
      <sound>
        <volume>12000</volume>
      </sound>
    </Y8960-OPL2>
    <primary slot="any">
      <secondary slot="any">
        <ROM id="Y8960 SCC">
          <mem base="0x4000" size="0x8000"/>
          <sound>
            <volume>11500</volume>
          </sound>
          <mappertype>Y8960</mappertype>
          <rom/>
          <opll0>Y8960 OPLL 0</opll0> <!-- I/O tunnel from 7FF4h -->
          <opll1>Y8960 OPLL 1</opll1> <!-- I/O tunnel from 7FF2h -->
          <opl2_0>Y8960 OPL2 0</opl2_0> <!-- I/O tunnel from 7FECh -->
          <opl2_1>Y8960 OPL2 1</opl2_1> <!-- I/O tunnel from 7FEEh -->
          <ssg>Y8960 SSG</ssg> <!-- I/O Enabler2 b4 -->
        </ROM>
      </secondary>
    </primary>
    <!-- 暫定。hra1129 さんは「まだ作ってないので未確定、B6h-B7h あたりが
         いいかも」との由。ioport.txt の記載とも一致するのでそれに合わせてある -->
    <Y8960-MIXER id="y8960-mixer">
      <io base="0xB6" num="2"/>
      <external>true</external>
      <channel num="0" idref="Y8960 OPLL 0"/>
      <channel num="1" idref="Y8960 OPLL 1"/>
      <channel num="2" idref="Y8960 OPL2 0"/>
      <channel num="3" idref="Y8960 OPL2 1"/>
      <channel num="4" idref="Y8960 SSG"/>
      <!-- channel num="5" は SSG 系統 1 用だったが、いまは 1 デバイスにまとめてある -->
      <channel num="6" idref="Y8960 DCSG 0"/>
      <channel num="7" idref="Y8960 DCSG 1"/>
      <!-- channel num="8" idref="Y8960 ADPCM"/ -->
      <channel num="9" idref="Y8960 SCC"/>
    </Y8960-MIXER>
  </devices>
</msxconfig>
